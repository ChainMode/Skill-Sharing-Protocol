# Ignore everything by default (GOV-05 process tool isolation)
*

# Allow public documentation and schema directories
!/docs/
!/docs/**
!/schema/
!/schema/**
!/schemas/
!/schemas/**
!/vectors/
!/vectors/**

# Allow TypeScript reference implementation and test config
!/src/
!/src/**
!/package.json
!/tsconfig.json
!/vitest.config.ts

# Allow essential project files
!/README.md
!/LICENSE
!/LICENSE-DOCS
!/SECURITY.md
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/.gitignore
!.github/
.github/*
!.github/workflows/
.github/workflows/*
!.github/workflows/docs-ci.yml

# Never allow OS metadata or build artifacts inside whitelisted trees
**/.DS_Store
node_modules/
dist/
